{
  "name": "github_reply_to_review",
  "description": "Reply to a review comment, e.g. 'Fixed in 3f2a1c'.",
  "input_schema": {
    "type": "object",
    "properties": {
      "repo": {
        "type": "string",
        "description": "owner/name, e.g. within/app"
      },
      "number": {
        "type": "integer"
      },
      "comment_id": {
        "type": "integer"
      },
      "body": {
        "type": "string"
      }
    },
    "required": [
      "repo",
      "number",
      "comment_id",
      "body"
    ]
  },
  "requires_approval": false,
  "placeholder": true,
  "api": {
    "provider": "github",
    "method": "POST",
    "endpoint": "/repos/{owner}/{repo}/pulls/{number}/comments/{comment_id}/replies"
  }
}
